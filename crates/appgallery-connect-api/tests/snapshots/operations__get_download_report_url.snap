      "endTime": {
        "description": "Query end time in UTC time. The format is YYYYMMDD. The interval between startTime and endTime cannot exceed 180 days.",
        "type": "string"
      },
      "exportType": {
        "description": "Exported file type. Options: CSV EXCEL The default value is CSV.",
        "type": "string"
      },
      "filterCondition": {
        "description": "Filters to apply; repeat the parameter for each filter: countryId, businessType, appVersion. Each filter needs a filterConditionValue in the same position.",
