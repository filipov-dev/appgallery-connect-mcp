          "type": "string"
        },
        "type": "array"
      },
      "filterConditionValue": {
        "description": "Values of the filters, in the same order as filterCondition. countryId: country or region codes (all for global data, others for the group of US, CU, IR, SD and SY). businessType: ALL, AppGallery or AppTouch (case sensitive). appVersion: versions separated by commas, or all.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "groupBy": {
        "description": "Statistics dimension. Options: date: by date. countryId: by country/region. businessType: by business type. appVersion: by app version. The default value is date.",
        "type": "string"
      },
      "language": {
        "description": "Query language. The report title can be displayed in different languages. Only Simplified Chinese (zh-CN), English (en-US), and Russian (ru-RU) are supported.",
