      },
      "maxReqCount": {
        "description": "Number of records returned on each page. The default value is 20, and the maximum value is 1000.",
        "type": "integer"
      },
      "packageNames": {
        "description": "List of app package names to be queried. Use commas (,) to separate multiple package names. A maximum of 100 package names are supported. Either appId or packageNames must be passed. If both of them are passed, appId is used.",
